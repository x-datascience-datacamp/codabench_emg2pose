# Adds extra-deps.txt to the running image without a full rebuild: the
# installed packages are frozen as constraints, so pip cannot upgrade them and
# fails instead of moving the stack under scored submissions. Build from the
# repo root and push under the competition tag:
#
#     docker build -f tools/Dockerfile.extra -t tommoral/emg2pose-compet:v1 .
#
# FROM is the image built by tools/Dockerfile, pinned by digest so rebuilds
# do not stack on each other.
FROM tommoral/emg2pose-compet@sha256:a228937496deb9adb3cf71f688a184fb6b5272c0e7511893ce6aa317dabd0842

COPY extra-deps.txt /tmp/extra-deps.txt
RUN pip list --format=freeze > /tmp/frozen.txt && \
    pip install --no-cache-dir -r /tmp/extra-deps.txt -c /tmp/frozen.txt
